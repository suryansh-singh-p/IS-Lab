# Public ports
FRONTEND_PORT=3000
BACKEND_PORT=5000

# Frontend build-time API base
VITE_API_URL=/api

# Backend CORS allowlist (comma-separated)
CORS_ORIGIN=https://your-frontend-domain.com

# Internal Postgres defaults (used when DATABASE_URL is not provided)
POSTGRES_DB=video_interview
POSTGRES_USER=video_interview
POSTGRES_PASSWORD=change_me

# If using managed Postgres, uncomment and set this instead
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# DATABASE_USE_SSL=true
