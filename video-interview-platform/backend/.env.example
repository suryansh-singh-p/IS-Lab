# Required for auth/session data
DATABASE_URL=postgresql://video_interview:change_me@postgres:5432/video_interview
DATABASE_USE_SSL=false

# Required in production: set a long random secret
JWT_SECRET=replace-with-strong-random-secret

# Optional: LLM evaluator key (without this, evaluation calls fail)
OPENROUTER_API_KEY=

# Transcription backend (choose one)
# OPENAI_API_KEY=
# WHISPER_SCRIPT_PATH=/app/scripts/whisper_transcribe.py
# Legacy alias still supported:
# WHISPERX_SCRIPT_PATH=/app/scripts/whisper_transcribe.py
# Optional fallback backend (best on Linux/macOS with build tools)
USE_WHISPER_NODE=false
WHISPER_MODEL=tiny.en

# Emotion analysis (DeepFace/TensorFlow). Disable locally if disk/memory is limited.
EMOTION_ANALYSIS_ENABLED=true

# Optional behavior flags
UPLOAD_WATCHER=true
PROCESS_PENDING_ON_STARTUP=true
CORS_ORIGIN=https://your-frontend-domain.com

# Optional media storage mode
USE_LOCAL_VIDEO_STORAGE=false
CLOUDINARY_URL=
