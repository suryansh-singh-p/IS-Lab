# ── Docker Compose host ports ──────────────────────────────────────────────
FRONTEND_PORT=3000
BACKEND_PORT=5000
OLLAMA_PORT=11434

# ── LLM provider ───────────────────────────────────────────────────────────
# Use 'ollama' for local server (default), 'openrouter' or 'openai' for cloud.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=llama3.2:3b
# LLM_API_KEY is only needed for openrouter/openai; leave as-is for Ollama.
LLM_API_KEY=ollama

# ── Backend runtime (also configure in backend/.env) ───────────────────────
# DATABASE_URL=postgresql://user:pass@host:5432/dbname?sslmode=require
# DATABASE_USE_SSL=true
# OPENROUTER_API_KEY=     (only needed if LLM_PROVIDER=openrouter)
# OPENAI_API_KEY=         (only needed if LLM_PROVIDER=openai)

